# Copy this file to backend/.env (the backend reads its own .env file).
# Then replace JWT_SECRET with a long random secret.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/college_attendance
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
ATTENDANCE_THRESHOLD=75
